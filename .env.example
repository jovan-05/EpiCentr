FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_GRAPH=northwind
# LLM via OpenRouter (https://openrouter.ai/keys). Keep the real key in .env, never commit it.
OPENROUTER_API_KEY=
# Free models only (":free"), tried in order; the next one is used if one is rate-limited or fails.
# Check which ones work for you with:  .venv\Scripts\python.exe -m api.llm
LLM_MODELS=nvidia/nemotron-3-super-120b-a12b:free,nvidia/nemotron-3.5-super-vl:free,poolside/laguna-s-2.1:free,dots-studio/dots-3-note-preview:free
KEYSTONE_API_URL=http://127.0.0.1:8000
